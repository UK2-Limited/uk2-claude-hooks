{
  "dangerousBash": {
    "disable": false,
    "rules": [
      {
        "reason": "recursive/forced 'rm' targeting a root / home / cwd / glob path",
        "match": [
          "(^|\\s)rm(\\s|$)",
          "(^|\\s)-[a-z0-9]*r|--recursive",
          "(^|\\s)-[a-z0-9]*f|--force",
          "\\s(/|/\\*|~|~/|\\$HOME|\\.|\\.\\.|\\*)(\\s|$)"
        ]
      },
      {
        "reason": "'git push --force' rewrites remote history",
        "match": ["git\\s+push", "--force([^-]|$)|--force-with-lease|(^|\\s)-f(\\s|$)"]
      },
      {
        "reason": "DROP/TRUNCATE against a non-test database",
        "match": ["DROP\\s+DATABASE|DROP\\s+TABLE|TRUNCATE\\s+TABLE"],
        "noMatch": ["test"]
      },
      {
        "reason": "'docker compose down -v' deletes named volumes (DB / object-storage data)",
        "match": ["docker(-|\\s+)compose\\s+down", "-v(\\s|$)|--volumes"]
      }
    ]
  },
  "protectedPaths": {
    "disable": false,
    "deny": [
      "conf/production/",
      "**/.env",
      "**/secrets/**"
    ],
    "warn": [
      "database/structure/"
    ]
  },
  "compileCheck": {
    "disable": false,
    "steps": [
      {
        "match": "\\.(pm|pl)$",
        "cwd": "{devenv}",
        "precheck": "docker compose ps api 2>/dev/null | grep -qiE 'up|running'",
        "cmd": "docker compose exec -T api perl -Ilib -c {file}"
      },
      {
        "match": "\\.tsx?$",
        "cmd": "npx tsc --noEmit",
        "timeoutMs": 120000
      },
      {
        "match": "\\.py$",
        "cmd": "python -m pyflakes {file} 2>&1 || true",
        "errorRe": "undefined name|invalid syntax"
      }
    ]
  },
  "testIntegrity": {
    "disable": false,
    "fileRe": "\\.test\\.[jt]sx?$",
    "assertRe": "\\bexpect\\s*\\(",
    "skipRe": "\\b(it|test|describe)\\.skip\\b|\\bxit\\b"
  },
  "stopGate": {
    "disable": false,
    "cmds": ["npm test", "npm run lint"],
    "timeoutMs": 120000,
    "maxBlocks": 3,
    "message": "Tests must pass before stopping (HEAD {head})."
  }
}
