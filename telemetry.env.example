# Telemetry shipping config — copy to <project>/.claude/telemetry/config.env
# and chmod 600. That directory must be gitignored by the consuming repo, so
# the real file can never be committed.
#
# If the file is absent (or UK2_TELEMETRY_DISABLE is set) shipping is silently
# disabled and the hooks only write local JSONL.
#
# Legacy names: every UK2_* key here also accepts its CHIMERA_* twin — an
# existing Chimera config.env keeps working unchanged.

# Cloudflare-tunnel hostname fronting Elasticsearch (no trailing slash).
# External side is always 443; cloudflared forwards to localhost:9200.
UK2_TELEMETRY_ES_URL="https://es.example.com"

# Target index (an index template for claude-telemetry* should exist).
UK2_TELEMETRY_ES_INDEX="claude-telemetry"

# Elasticsearch API key — the 'encoded' value from POST /_security/api_key.
# Leave empty if the cluster runs with xpack.security.enabled: false.
UK2_TELEMETRY_ES_API_KEY=""

# Cloudflare Access service token (Zero Trust -> Access -> Service Auth).
# Sent as CF-Access-Client-Id / CF-Access-Client-Secret headers.
UK2_TELEMETRY_CF_CLIENT_ID=""
UK2_TELEMETRY_CF_CLIENT_SECRET=""

# Kill switch: uncomment to stop shipping without deleting this file.
# UK2_TELEMETRY_DISABLE=1
