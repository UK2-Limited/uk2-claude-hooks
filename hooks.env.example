# Behavioural-gate config for the uk2-claude-hooks plugin (all optional).
# Copy to <project>/.claude/validation/hooks.env and commit it — no secrets
# belong in here. Override the location with UK2_HOOKS_CONFIG=<path>.
#
# Every key also works as a plain environment variable; values in this file
# override the environment. Each UK2_* name accepts a CHIMERA_* twin.

## compile-check ------------------------------------------------------------
# Numbered steps (1..20, gaps allowed), run in order against every edited
# file whose repo-relative path matches _MATCH (no _MATCH = every file).
# The first failing step blocks Claude with the command's output.
# With no steps defined, the built-in Chimera default runs instead
# (perl -c in the docker-compose api container for *.pm/*.pl).
#
# Placeholders in _CMD/_PRECHECK/_CWD:
#   {file}    repo-relative path of the edited file (shell-quoted)
#   {root}    project root
#   {devenv}  UK2_DEVENV_DIR (default <project>/..)
#
# Per step: _CMD (required), _MATCH (path regex), _CWD (default {root}),
# _PRECHECK (non-zero exit -> step skipped quietly, e.g. "is the container
# up"), _ERROR_RE (fail when the output matches, even at exit 0),
# _TIMEOUT_MS (default 60000).

# The built-in Chimera default, expressed as a step:
#UK2_COMPILE_CHECK_1_MATCH="\.(pm|pl)$"
#UK2_COMPILE_CHECK_1_CWD="{devenv}"
#UK2_COMPILE_CHECK_1_PRECHECK="docker compose ps api 2>/dev/null | grep -qiE 'up|running'"
#UK2_COMPILE_CHECK_1_CMD="docker compose exec -T api perl -Ilib -c {file}"

# A TypeScript project:
#UK2_COMPILE_CHECK_1_MATCH="\.tsx?$"
#UK2_COMPILE_CHECK_1_CMD="npx tsc --noEmit"
#UK2_COMPILE_CHECK_1_TIMEOUT_MS=120000

# Failing on output rather than exit code:
#UK2_COMPILE_CHECK_2_MATCH="\.py$"
#UK2_COMPILE_CHECK_2_CMD="python -m pyflakes {file} 2>&1 || true"
#UK2_COMPILE_CHECK_2_ERROR_RE="undefined name|invalid syntax"

#UK2_COMPILE_CHECK_DISABLE=1

## test-integrity -----------------------------------------------------------
# Regexes replacing the built-in Perl heuristics; set them together so they
# describe the same test dialect.
#UK2_TEST_INTEGRITY_FILE_RE="\.test\.[jt]sx?$"                       # which files count as tests
#UK2_TEST_INTEGRITY_ASSERT_RE="\bexpect\s*\("                        # counted before/after (flag g)
#UK2_TEST_INTEGRITY_SKIP_RE="\b(it|test|describe)\.skip\b|\bxit\b"   # flags im
#UK2_TEST_INTEGRITY_DISABLE=1

## stop-require-evidence (agent/CI mode only) --------------------------------
# Exit 0 = evidence; replaces the .claude/state/verify.json sentinel check.
# Placeholders: {root}, {head} (current HEAD commit).
#UK2_STOP_GATE_CMD="npm test"
#UK2_STOP_GATE_TIMEOUT_MS=120000
#UK2_STOP_GATE_MAX_BLOCKS=3
#UK2_STOP_GATE_MESSAGE="Tests must pass before stopping (HEAD {head})."
#UK2_STOP_GATE_DISABLE=1
