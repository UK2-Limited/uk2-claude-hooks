        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "Max": "last seen",
              "Max ts": "last seen",
              "Min": "first seen",
              "Min ts": "first seen",
              "Count": "events",
              "Unique Count": "sessions",
              "Unique Count session_id": "sessions"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "ago",
            "mode": "binary",
            "binary": {
              "left": "last seen",
              "operator": "*",
              "right": "1"
